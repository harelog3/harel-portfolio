---
import { twMerge } from "tailwind-merge";

interface Props {
    name: string;
    path: string;
    isSelected: boolean;
}

const { name, path, isSelected } = Astro.props;

const listItemClasses = twMerge(
    "p-2",
    isSelected && "bg-emerald-500 text-white rounded-full"
);
const anchorClasses = twMerge(
    "md:flex md:gap-2",
    !isSelected &&
        "md:opacity-80 md:transition-opacity md:hover:opacity-100 md:duration-100"
);
---

<li class={`${listItemClasses || undefined}`}>
    <!-- For big screen devices -->
    <a class={anchorClasses + " hidden md:block"} href={path}>
        <slot />
        {name}
    </a>

    <!-- For small screen devices -->
    <a class={anchorClasses + " md:hidden"} href={path}>
        <slot />
    </a>
</li>
