---
import { House, User, Brain, BriefcaseBusiness, Send } from "@lucide/astro";
import NavbarItem from "./NavbarItem.astro";
import { pathResolver } from "../../../utils/path-resolver";
const path = Astro.originPathname;

const homeSelected = pathResolver(path) === "/";
const aboutSelected = pathResolver(path) === "/about/";
const skillsSelected = pathResolver(path) === "/skills/";
const workSelected = pathResolver(path) === "/work/";
const projectsSelected = pathResolver(path) === "/projects/";
---

<ul
    class="list-none w-full text-center flex justify-center gap-3 md:gap-6 items-center"
>
    <NavbarItem name="Home" path="/" isSelected={homeSelected}>
        <House />
    </NavbarItem>

    <NavbarItem name="About" path="/about" isSelected={aboutSelected}>
        <User />
    </NavbarItem>

    <NavbarItem name="Skills" path="/skills" isSelected={skillsSelected}>
        <Brain />
    </NavbarItem>

    <NavbarItem name="Work" path="/work" isSelected={workSelected}>
        <BriefcaseBusiness />
    </NavbarItem>

    <NavbarItem name="Contact" path="/contact" isSelected={projectsSelected}>
        <Send />
    </NavbarItem>
</ul>
