---
import { BriefcaseBusinessIcon } from "@lucide/astro";

type ExperienceEntryType = "work";

interface ExperiencePeriod {
    label: string;
    start: string;
    end?: string;
}

interface ExperienceEntry {
    id: string;
    type: ExperienceEntryType;
    typeLabel: string;
    company: string;
    role: string;
    period: ExperiencePeriod;
    summary: string;
    highlights: string[];
    technologies?: string[];
}

interface Props {
    entry: ExperienceEntry;
    index: number;
}

const { entry, index } = Astro.props as Props;

// Desktop alternates cards around the center rail while mobile stays single-sided.
const isLeftAligned = index % 2 === 0;

const itemClass =
    "experience-item relative grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-4 md:grid-cols-[minmax(0,1fr)_4rem_minmax(0,1fr)] md:gap-0";

const markerClass = [
    "experience-marker relative z-10 col-start-1 row-start-1 flex h-8 w-8 items-center justify-center rounded-full border bg-base dark:bg-base-dark md:col-start-2 md:mx-auto",
    "border-primary/50 text-primary",
]
    .filter(Boolean)
    .join(" ");

const contentClass = [
    "experience-card bg-earth-50/45 ring-earth-200 dark:bg-earth-900/35 dark:ring-earth-800 col-start-2 row-start-1 flex flex-col gap-5 rounded-3xl p-5 ring-1 sm:p-6",
    isLeftAligned
        ? "experience-card-left md:col-start-1 md:mr-8 md:text-right"
        : "experience-card-right md:col-start-3 md:ml-8",
]
    .filter(Boolean)
    .join(" ");
---

<li class={itemClass} style={`--index:${index};`}>
    <div class={markerClass} aria-hidden="true">
        <BriefcaseBusinessIcon class="h-4 w-4" />
    </div>

    <article
        class={contentClass}
        aria-labelledby={`experience-${entry.id}-title`}
    >
        <div
            class:list={[
                "flex flex-wrap items-center gap-2",
                isLeftAligned ? "md:justify-end" : "",
            ]}
        >
            <span
                class="bg-secondary/10 text-secondary rounded-full px-3 py-1 text-[11px] font-semibold tracking-[0.12em] uppercase"
            >
                {entry.period.label}
            </span>
            <span
                class="bg-earth-100 text-earth-700 dark:bg-earth-800 dark:text-earth-200 rounded-full px-3 py-1 text-[11px] font-semibold tracking-[0.12em] uppercase"
            >
                {entry.typeLabel}
            </span>
        </div>

        <div class="space-y-2">
            <h3
                id={`experience-${entry.id}-title`}
                class="text-earth-900 dark:text-earth-50 text-2xl leading-tight font-bold tracking-tight"
            >
                {entry.role}
            </h3>
            <p
                class="text-earth-700 dark:text-earth-200 text-sm font-semibold tracking-tight"
            >
                {entry.company}
            </p>
            <time
                class="text-earth-500 dark:text-earth-300 block text-xs font-semibold tracking-[0.12em] uppercase"
                datetime={entry.period.start}
            >
                {entry.period.label}
            </time>
        </div>

        <p
            class="text-earth-700 dark:text-earth-100/80 text-sm leading-relaxed"
        >
            {entry.summary}
        </p>

        <ul class="space-y-2 text-sm">
            {
                entry.highlights.map((highlight) => (
                    <li class="text-earth-700 dark:text-earth-200 flex gap-2 leading-relaxed">
                        <span class="text-primary mt-[0.2rem] shrink-0">
                            &gt;&gt;
                        </span>
                        <span>{highlight}</span>
                    </li>
                ))
            }
        </ul>

        {
            entry.technologies && entry.technologies.length > 0 && (
                <div
                    class:list={[
                        "mt-auto flex flex-wrap gap-2",
                        isLeftAligned ? "md:justify-end" : "",
                    ]}
                >
                    {entry.technologies.map((technology) => (
                        <span class="bg-earth-100 text-earth-700 dark:bg-earth-800 dark:text-earth-200 rounded-md px-2 py-1 text-[10px] font-semibold">
                            {technology}
                        </span>
                    ))}
                </div>
            )
        }
    </article>
</li>

<style>
    @keyframes experience-card-enter-left {
        0% {
            opacity: 0;
            transform: translate3d(-24px, 18px, 0) scale(0.985);
            filter: blur(12px);
        }

        100% {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
    }

    @keyframes experience-card-enter-right {
        0% {
            opacity: 0;
            transform: translate3d(24px, 18px, 0) scale(0.985);
            filter: blur(12px);
        }

        100% {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
    }

    @keyframes experience-card-enter-mobile {
        0% {
            opacity: 0;
            transform: translate3d(0, 20px, 0) scale(0.985);
            filter: blur(12px);
        }

        100% {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
    }

    @keyframes experience-marker-arrive {
        0% {
            opacity: 0;
            transform: scale(0.75);
            box-shadow: 0 0 0 0
                color-mix(in srgb, var(--color-primary) 0%, transparent);
        }

        70% {
            opacity: 1;
            transform: scale(1.06);
            box-shadow: 0 0 0 10px
                color-mix(in srgb, var(--color-primary) 12%, transparent);
        }

        100% {
            opacity: 1;
            transform: scale(1);
            box-shadow: 0 0 0 0
                color-mix(in srgb, var(--color-primary) 0%, transparent);
        }
    }

    .experience-card,
    .experience-marker {
        will-change: opacity, transform, filter;
    }

    .experience-card {
        opacity: 0;
        animation: experience-card-enter-mobile 0.72s
            cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(0.34s + (var(--index, 0) * 0.1s));
    }

    .experience-marker {
        opacity: 0;
        animation: experience-marker-arrive 0.58s cubic-bezier(0.22, 1, 0.36, 1)
            both;
        animation-delay: calc(0.28s + (var(--index, 0) * 0.1s));
    }

    @media (min-width: 48rem) {
        .experience-card-left {
            animation-name: experience-card-enter-left;
        }

        .experience-card-right {
            animation-name: experience-card-enter-right;
        }
    }

    @supports (animation-timeline: view()) {
        .experience-item {
            view-timeline-name: --experience-item;
            view-timeline-axis: block;
        }

        .experience-card,
        .experience-marker {
            animation-delay: 0s;
            animation-timeline: --experience-item;
            animation-range: entry 15% cover 42%;
        }

        .experience-marker {
            animation-range: entry 12% cover 34%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .experience-card,
        .experience-marker {
            opacity: 1;
            animation: none;
            filter: none;
            transform: none;
            box-shadow: none;
        }
    }
</style>
