---
import { DownloadIcon, Link2Icon } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import Button from "../../ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Replace placeholder URLs once final profile links are available.
const socialLinks = [
    {
        href: "https://github.com/harelog3",
        label: t("home.about.github"),
        logoSrc: "/logos/github.svg",
    },
    {
        href: "https://www.linkedin.com/in/harel-alejandro-olgu%C3%ADn-gayt%C3%A1n-505b5a262/",
        label: t("home.about.linkedin"),
        logoSrc: "/logos/linkedin.svg",
    },
    {
        href: "https://harelog3.github.io/bio-links/",
        label: t("home.about.linkInBio"),
    },
];
---

<section class="mx-auto w-full max-w-6xl px-6 py-18 sm:px-8 lg:px-10 lg:py-24">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="flex flex-col gap-7 lg:col-span-7">
            <span
                class="text-primary ring-primary/20 bg-primary/10 w-fit rounded-full px-4 py-1.5 text-xs font-semibold tracking-tight ring-1"
            >
                {t("home.about.tag")}
            </span>

            <div class="space-y-5">
                <h1
                    class="text-earth-900 dark:text-earth-50 text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl"
                >
                    {t("home.about.title")}
                </h1>
                <p
                    class="text-earth-700 dark:text-earth-100/80 max-w-2xl leading-relaxed sm:text-lg"
                >
                    {t("home.about.description")}
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-1">
                <Button href="/harel_resume_english.pdf" class="px-7 py-3.5">
                    <DownloadIcon slot="icon" class="h-4 w-4" />
                    <span>{t("home.about.downloadCv")}</span>
                </Button>
            </div>

            <div class="flex items-center gap-3 pt-1">
                {
                    socialLinks.map((item) => {
                        return (
                            <a
                                href={item.href}
                                aria-label={item.label}
                                title={item.label}
                                class="bg-earth-50 text-earth-700 ring-earth-700/10 hover:text-secondary hover:ring-secondary/40 dark:bg-earth-800 dark:text-earth-100 dark:ring-earth-100/10 dark:hover:text-earth-50 inline-flex h-11 w-11 items-center justify-center rounded-xl ring-1 transition-all hover:-translate-y-0.5"
                                target="_blank"
                            >
                                {item.logoSrc ? (
                                    <img
                                        src={item.logoSrc}
                                        alt=""
                                        class="h-5 w-5"
                                        aria-hidden="true"
                                    />
                                ) : (
                                    <Link2Icon class="h-5 w-5" />
                                )}
                            </a>
                        );
                    })
                }
            </div>
        </div>

        <div class="relative lg:col-span-5">
            <div
                class="bg-earth-100 ring-earth-700/10 dark:bg-earth-800 dark:ring-earth-100/10 overflow-hidden rounded-4xl p-5 shadow-2xl ring-1"
            >
                <div
                    class="bg-earth-200 dark:bg-earth-700 aspect-4/5 overflow-hidden rounded-[1.35rem] sm:aspect-square"
                >
                    <img
                        src="/images/harel-cartoon.png"
                        alt={t("home.about.imageAlt")}
                        class="h-full w-full object-contain"
                        loading="eager"
                    />
                </div>
            </div>
            <div
                class="bg-base dark:bg-earth-800 ring-earth-700/10 dark:ring-earth-100/10 absolute -bottom-5 -left-5 rounded-xl px-4 py-3 shadow-lg ring-1"
            >
                <p
                    class="text-secondary text-2xl leading-none font-bold uppercase"
                >
                    Harel
                </p>
                <p
                    class="text-earth-600 dark:text-earth-100/70 mt-1 text-center text-[10px] font-semibold tracking-[0.2em] uppercase"
                >
                    Olguín
                </p>
            </div>
        </div>
    </div>
</section>
