---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import PageContainer from "../../ui/PageContainer.astro";
import PageSectionIntro from "../../ui/PageSectionIntro.astro";
import SkillsTabs from "./SkillsTabs.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type SkillLevel = "expert" | "advanced" | "intermediate";

interface SkillItem {
    name: string;
    level: SkillLevel;
    description: string;
    tags: string[];
    logoSrc?: string;
    logoAlt?: string;
    loading?: "eager" | "lazy";
}

interface SkillTab {
    id: string;
    label: string;
    items: SkillItem[];
}

const levelLabels = {
    expert: t("skills.level.expert"),
    advanced: t("skills.level.advanced"),
    intermediate: t("skills.level.intermediate"),
} as const;

// Skills content is data-driven so updates can happen without touching markup.
