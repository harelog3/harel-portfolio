---

<section class="skills-page pb-18 sm:pb-20 lg:pb-24">
    <PageContainer class="flex flex-col gap-16">
        <div class="skills-intro-wrap">
            <PageSectionIntro
                badge={t("skills.intro.badge")}
                title={t("skills.intro.title")}
                titleAccent={t("skills.intro.titleAccent")}
                description={t("skills.intro.description")}
                class="pt-6 sm:pt-10"
            />
        </div>

        <div class="skills-tabs-wrap">
            <SkillsTabs
                tabs={tabsForView}
                ariaLabel={t("skills.tabs.ariaLabel")}
            />
        </div>

        <div
            class="skills-support-grid border-earth-200/90 dark:border-earth-800/90 grid grid-cols-1 gap-6 border-t pt-14 lg:grid-cols-2"
        >
            <article
                class="skills-support-card bg-earth-50/45 dark:bg-earth-900/35 ring-earth-200 dark:ring-earth-800 flex flex-col gap-6 rounded-3xl p-6 ring-1 sm:p-7"
            >
                <div class="flex items-start gap-4">
                    <div
                        class="bg-earth-100 dark:bg-earth-800 ring-earth-200 dark:ring-earth-700 flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl ring-1"
                    >
                        <Image
                            src="/logos/iteso.png"
                            alt="ITESO logo"
                            width={56}
                            height={56}
                            class="h-full w-full object-contain p-1"
                            loading="lazy"
                        />
                    </div>
                    <div class="space-y-2">
                        <h2
                            class="text-earth-900 dark:text-earth-50 text-2xl leading-tight font-bold tracking-tight"
                        >
                            {t("skills.education.title")}
                        </h2>
                        <p
                            class="text-earth-700 dark:text-earth-100/80 text-sm leading-relaxed"
                        >
                            {t("skills.education.degree")}
                        </p>
                    </div>
                </div>

                <div class="space-y-2">
                    <p
                        class="text-earth-600 dark:text-earth-200 text-xs font-semibold tracking-[0.16em] uppercase"
                    >
                        {t("skills.education.institutionLabel")}
                    </p>
                    <p
                        class="text-earth-700 dark:text-earth-100/80 leading-relaxed"
                    >
                        {t("skills.education.institution")}
                    </p>
                </div>

                <div class="space-y-2">
                    <p
                        class="text-earth-600 dark:text-earth-200 text-xs font-semibold tracking-[0.16em] uppercase"
                    >
                        {t("skills.education.periodLabel")}
                    </p>
                    <p
                        class="text-earth-700 dark:text-earth-100/80 leading-relaxed"
                    >
                        {t("skills.education.period")}
                    </p>
                </div>
            </article>

            <article
                class="skills-support-card bg-earth-50/45 dark:bg-earth-900/35 ring-earth-200 dark:ring-earth-800 flex flex-col gap-6 rounded-3xl p-6 ring-1 sm:p-7"
            >
                <h2
                    class="text-earth-900 dark:text-earth-50 text-2xl leading-tight font-bold tracking-tight"
                >
                    {t("skills.soft.title")}
                </h2>
                <p
                    class="text-earth-700 dark:text-earth-100/80 text-sm leading-relaxed"
                >
                    {t("skills.soft.description")}
                </p>

                <div class="flex flex-wrap gap-2">
                    <span
                        class="bg-earth-100 text-earth-700 dark:bg-earth-800 dark:text-earth-200 rounded-md px-3 py-1.5 text-xs font-semibold tracking-tight"
                    >
                        {t("skills.soft.problemSolving")}
                    </span>
                    <span
                        class="bg-earth-100 text-earth-700 dark:bg-earth-800 dark:text-earth-200 rounded-md px-3 py-1.5 text-xs font-semibold tracking-tight"
                    >
                        {t("skills.soft.teamwork")}
                    </span>
                    <span
                        class="bg-earth-100 text-earth-700 dark:bg-earth-800 dark:text-earth-200 rounded-md px-3 py-1.5 text-xs font-semibold tracking-tight"
                    >
                        {t("skills.soft.communication")}
                    </span>
                </div>
            </article>
        </div>
    </PageContainer>
</section>

<style>
    @keyframes skills-rise-fade {
        0% {
            opacity: 0;
            transform: translate3d(0, 26px, 0) scale(0.985);
            filter: blur(12px);
        }

        100% {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
    }

    @keyframes skills-slide-settle {
        0% {
            opacity: 0;
            transform: translate3d(-18px, 18px, 0);
            filter: blur(10px);
        }

        100% {
            opacity: 1;
            transform: translate3d(0, 0, 0);
            filter: blur(0);
        }
    }

    .skills-page {
        --skills-enter-ease: cubic-bezier(0.2, 0.9, 0.2, 1);
        --skills-enter-fill: both;
    }

    .skills-intro-wrap {
        opacity: 0;
        animation: skills-rise-fade 0.78s var(--skills-enter-ease)
            var(--skills-enter-fill);
        animation-delay: 0.08s;
        will-change: opacity, transform, filter;
    }

    .skills-tabs-wrap {
        opacity: 0;
        animation: skills-slide-settle 0.72s var(--skills-enter-ease)
            var(--skills-enter-fill);
        animation-delay: 0.2s;
        will-change: opacity, transform, filter;
    }

    .skills-support-card {
        opacity: 0;
        animation: skills-rise-fade 0.82s var(--skills-enter-ease)
            var(--skills-enter-fill);
        will-change: opacity, transform, filter;
    }

    .skills-support-card:nth-child(1) {
        animation-delay: 0.62s;
    }

    .skills-support-card:nth-child(2) {
        animation-delay: 0.76s;
    }

    @media (prefers-reduced-motion: reduce) {
        :where(.skills-intro-wrap, .skills-tabs-wrap, .skills-support-card) {
            opacity: 1;
            animation: none;
            filter: none;
            transform: none;
        }
    }
</style>
