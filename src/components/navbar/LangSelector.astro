---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Languages } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const currentLocale = getLangFromUrl(Astro.url);
const t = useTranslations(currentLocale);
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalizedPath = pathname.replace(/^\/(en|es)(?=\/|$)/, "") || "/";
const route = normalizedPath === "/" ? undefined : normalizedPath.slice(1);

const locales = [
    { code: "en", label: t("lang.english"), flag: "🇺🇸" },
    { code: "es", label: t("lang.spanishMx"), flag: "🇲🇽" },
];
---

<details class="lang-menu group relative">
    <summary
        class="text-earth-900 ring-earth-900/10 hover:text-primary hover:bg-earth-100/70 dark:text-earth-50 dark:hover:bg-earth-800/80 dark:hover:text-white flex cursor-pointer list-none items-center rounded-full px-3 py-2 ring-1 transition-all duration-200 [&::-webkit-details-marker]:hidden"
        aria-label={t("lang.change")}
    >
        <span class="sr-only">{t("lang.change")}</span>
        <Languages size={16} stroke-width={2} aria-hidden="true" />
    </summary>

    <div
        class="lang-menu-panel bg-base/95 ring-earth-900/10 dark:bg-earth-800/95 dark:ring-white/10 absolute top-[calc(100%+0.5rem)] right-0 z-50 flex min-w-44 flex-col gap-1 rounded-xl p-1.5 opacity-0 shadow-xl ring-1 backdrop-blur-md"
    >
        {
            locales.map((locale) => {
                const href = route
                    ? getRelativeLocaleUrl(locale.code, route)
                    : getRelativeLocaleUrl(locale.code);

                return (
                    <a
                        href={href}
                        aria-label={locale.label}
                        class:list={[
                            "text-earth-900 hover:bg-earth-100 dark:text-earth-50 dark:hover:bg-earth-700/70 flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                            currentLocale === locale.code &&
                                "bg-primary/10 text-primary dark:text-white",
                        ]}
                        aria-current={currentLocale === locale.code
                            ? "page"
                            : undefined}
                    >
                        <span class="flex items-center gap-2">
                            <span>{locale.flag}</span>
                            <span>{locale.label}</span>
                        </span>
                    </a>
                );
            })
        }
    </div>
</details>

<style>
    .lang-menu .lang-menu-panel {
        pointer-events: none;
        transform: translateY(-6px);
        transition: opacity 0.16s ease, transform 0.16s ease;
    }

    .lang-menu[open] .lang-menu-panel {
        pointer-events: auto;
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script is:inline>
    (() => {
        if (window.__langSelectorOutsideClickBound) return;
        window.__langSelectorOutsideClickBound = true;

        const closeOpenMenus = (exceptMenu) => {
            const menus = document.querySelectorAll("details.lang-menu[open]");
            menus.forEach((menu) => {
                if (menu !== exceptMenu) menu.removeAttribute("open");
            });
        };

        document.addEventListener("click", (event) => {
            if (!(event.target instanceof Node)) return;

            const clickedInsideMenu = event.target.closest("details.lang-menu");
            if (!clickedInsideMenu) closeOpenMenus(null);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeOpenMenus(null);
        });
    })();
</script>
