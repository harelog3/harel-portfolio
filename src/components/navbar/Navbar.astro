---
import LangSelector from "./LangSelector.astro";
import MobileNavbar from "./MobileNavbar.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const currentLocale = getLangFromUrl(Astro.url);
const t = useTranslations(currentLocale);
const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/^\/(en|es)(?=\/|$)/, "") || "/";

const links = [
    { href: "/", route: undefined, label: t("nav.home") },
    { href: "/skills", route: "skills", label: t("nav.skills") },
    {
        href: "/experience",
        route: "experience",
        label: t("nav.experience"),
    },
    { href: "/projects", route: "projects", label: t("nav.projects") },
];

const isActive = (href: string) => {
    if (href === "/") return normalizedPath === "/";
    return (
        normalizedPath === href || normalizedPath.startsWith(`${href}/`)
    );
};

const currentTitle = links.find((link) => isActive(link.href))?.label ?? t("nav.home");
---

<nav
    class="fixed top-3 right-0 left-0 z-50 flex justify-center px-2 sm:top-6 sm:px-4"
    transition:name="site-navbar"
>
    <MobileNavbar
        links={links}
        currentLocale={currentLocale}
        normalizedPath={normalizedPath}
        currentTitle={currentTitle}
    />

    <div
        class="glass-nav ring-earth-900/10 shadow-earth-900/5 hidden items-center gap-1 rounded-full px-2 py-1.5 shadow-xl ring-1 sm:flex sm:gap-2 sm:px-3 sm:py-2"
    >
        {
            links.map((link) => (
                <a
                    href={
                        link.route
                            ? getRelativeLocaleUrl(currentLocale, link.route)
                            : getRelativeLocaleUrl(currentLocale)
                    }
                    aria-current={isActive(link.href) ? "page" : undefined}
                    transition:name={
                        isActive(link.href) ? "active-nav-pill" : undefined
                    }
                    class:list={[
                        "rounded-full px-3 py-1.5 text-xs font-semibold transition-all duration-200 sm:px-5 sm:py-2 sm:text-sm",
                        isActive(link.href)
                            ? "bg-primary shadow-primary/25 text-white shadow-md"
                            : "text-earth-900 hover:text-primary dark:text-earth-50 dark:hover:text-white",
                    ]}
                >
                    {link.label}
                </a>
            ))
        }

        <div class="bg-earth-700/20 dark:bg-earth-600/40 mx-1 h-4 w-px"></div>
        <LangSelector />
    </div>
</nav>
